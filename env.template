# Judge Jev - environment variable template
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Wrangler reads `.env` automatically for local development.

# D1 database binding (set automatically by wrangler.jsonc; override if needed)
# JUDGE_JEV_RUNS=

# The actual Jev judging endpoint. There is no standalone Jev service yet, so
# this is the base URL of an OpenAI-compatible chat completions server (e.g. a
# local vLLM box) that gets prompted with the rubric and candidates and asked
# to pick a winner. When JEV_API_ENDPOINT is unset, /v1/* skips Jev entirely
# and uses the in-process longest-candidate heuristic instead.
# JEV_API_ENDPOINT=http://<host>:8000/v1
# JEV_API_KEY=
# Model name to prompt as the judge at JEV_API_ENDPOINT. Required whenever
# JEV_API_ENDPOINT is set.
# JEV_MODEL=Qwen/Qwen3-1.7B
# What to do if the Jev call itself fails (network error, bad/undecodable
# verdict, etc). "fallback" (default) silently serves the local heuristic's
# winner instead. Set to "error" while testing Jev integration so a broken
# Jev call surfaces as a judge_error instead of being masked by the fallback.
# JEV_ON_FAILURE=fallback

# Provider API keys used by the local model gateway
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional custom base URLs for OpenAI-compatible endpoints (e.g., vLLM)
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
