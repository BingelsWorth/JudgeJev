# Judge Jev - environment variable template
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Wrangler reads `.env` automatically for local development.

# D1 database binding (set automatically by wrangler.jsonc; override if needed)
# JUDGE_JEV_RUNS=

# Jev is TypeSafe's decision model (https://docs.typesafe.ai), a fixed public
# API - NOT an LLM JudgeJev prompts itself and NOT one of the models JudgeJev
# fans requests out to. JudgeJev POSTs it the original request, every fan-out
# candidate, and the rubric as a "choice" question, and Jev POSTs back which
# candidate id won. There is nothing to configure for the endpoint itself -
# just set JEV_API_KEY. Unset = /v1/* skips Jev entirely and uses the
# in-process longest-candidate heuristic instead.
# JEV_API_KEY=
# Jev model version. Defaults to "jev-latest" (TypeSafe's recommended default).
# JEV_MODEL=jev-latest
# Overrides Jev's fixed endpoint - only for tests/mocks, never needed for real use.
# JEV_API_ENDPOINT=
# What to do if the Jev call itself fails (network error, bad/undecodable
# verdict, etc). "fallback" (default) silently serves the local heuristic's
# winner instead. Set to "error" while testing Jev integration so a broken
# Jev call surfaces as a judge_error instead of being masked by the fallback.
# JEV_ON_FAILURE=fallback

# Default route registrations: a JSON array, same shape as the request body's
# `modelConfigs` field - a config block per entry with its own endpoint + token
# plus a model-name -> attempt-count fan-out dictionary. Used whenever a
# request doesn't supply its own modelConfigs. This is the only way to point a
# route at a specific endpoint; there is no per-provider base-URL override.
# apiKey here is a placeholder for an unauthenticated box, not real auth -
# buildModel() requires some non-empty key to be present regardless.
# MODEL_CONFIGS=[{"name":"local-qwen","provider":"openai","model":"Qwen/Qwen3-1.7B","endpoint":"http://192.168.2.106:8000/v1","apiKey":"unauthenticated","fanout":{"fast":1}}]

# Provider API keys, used as the auth fallback for any route that doesn't set
# its own apiKey in MODEL_CONFIGS.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
