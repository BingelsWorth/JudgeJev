# Judge Jev - environment variable template
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Wrangler reads `.env` automatically for local development.

# D1 database binding (set automatically by wrangler.jsonc; override if needed)
# JUDGE_JEV_RUNS=

# Jev (https://docs.typesafe.ai) judges the fan-out candidates. Fixed public
# endpoint, so the key is all that's needed to activate it.
# JEV_API_KEY=

# Jev model version (default: jev-latest)
# JEV_MODEL=

# Only for tests/mocks - overrides Jev's fixed endpoint
# JEV_API_ENDPOINT=

# "fallback" (default) uses the local heuristic if Jev fails; "error" surfaces a judge_error instead
# JEV_ON_FAILURE=

# Default fan-out routes: JSON array, same shape as the request body's `modelConfigs`.
# Each route needs its own apiKey - there is no provider-level key fallback.
# MODEL_CONFIGS=[{"name":"local-qwen","provider":"openai","model":"Qwen/Qwen3-1.7B","endpoint":"http://192.168.2.106:8000/v1","apiKey":"unauthenticated","fanout":{"fast":1}}]
