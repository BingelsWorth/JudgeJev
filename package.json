{
  "name": "judge-jev",
  "version": "0.1.0",
  "description": "Judge Jev — a TypeScript Cloudflare service that uses a Monoize-style provider layer to talk to models and LangGraph to manage, inspect, prune, restart, and judge multiple model runs.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "hono": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "typescript": "^5.5.0",
    "vitest": "^1.0.0",
    "wrangler": "^4.0.0"
  }
}
